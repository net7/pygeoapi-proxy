COMPOSE_PROJECT_NAME=pygeoapi-proxy-staging
STACK_ENV=staging

HOST_BIND_ADDRESS=127.0.0.1
APP_PORT=7070
REVERB_HOST_PORT=7071

APP_NAME="Geo-INQUIRE Saas"
APP_ENV=staging
APP_KEY=base64:CHANGE_THIS_TO_A_REAL_32_BYTE_BASE64_KEY
APP_DEBUG=false
APP_URL=https://proxygeoapi.netseven.work
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI="${APP_URL}/auth/orcid/callback"

LOG_CHANNEL=stderr
LOG_LEVEL=info

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MARIADB_ROOT_PASSWORD=change-this-staging-root-password
MARIADB_DATABASE=pygeoapi_proxy
MARIADB_USER=pygeoapi_proxy
MARIADB_PASSWORD=change-this-staging-password

REDIS_PASSWORD=

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=staging
REVERB_APP_KEY=change-this-staging-reverb-key
REVERB_APP_SECRET=change-this-staging-reverb-secret
REVERB_HOST=proxygeoapi.netseven.work
REVERB_PORT=443
REVERB_SCHEME=https

PYGEOAPI_BASE_URL=http://pygeoapi
PYGEOAPI_SERVER_URL=http://pygeoapi

PHP_MEMORY_LIMIT=2G
PHP_MAX_EXECUTION_TIME=120
PHP_MAX_INPUT_TIME=60
PHP_MAX_INPUT_VARS=3000
PHP_UPLOAD_MAX_FILE_SIZE=100M
PHP_POST_MAX_SIZE=100M
NGINX_CLIENT_MAX_BODY_SIZE=100M
PHP_OPCACHE_ENABLE=1
PHP_OPCACHE_MEMORY_CONSUMPTION=256
PHP_OPCACHE_MAX_ACCELERATED_FILES=20000
PHP_OPCACHE_REVALIDATE_FREQ=0
PHP_OPCACHE_VALIDATE_TIMESTAMPS=0
SSL_MODE=off

VITE_APP_NAME="Pygeoapi Proxy"
