COMPOSE_PROJECT_NAME=pygeoapi-proxy-develop
STACK_ENV=develop

APP_HOST=ingv.test
APP_PORT=8088
REVERB_HOST_PORT=8089
VITE_PORT=5174
VITE_DEV_SERVER_URL=http://ingv.test:5174
VITE_DEV_SERVER_HOST=ingv.test
VITE_DEV_SERVER_ALLOWED_HOSTS=ingv.test
VITE_DEV_SERVER_PORT=5173
VITE_DEV_SERVER_CLIENT_PORT=5174
PYGEOAPI_PORT=5000
PHPMYADMIN_PORT=8090
MAILPIT_PORT=8026

APP_NAME="Pygeoapi Proxy"
APP_ENV=local
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://ingv.test
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_LEVEL=debug

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MARIADB_ROOT_PASSWORD=develop-root-password
MARIADB_DATABASE=pygeoapi_proxy
MARIADB_USER=pygeoapi_proxy
MARIADB_PASSWORD=develop-password

REDIS_PASSWORD=

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=develop
REVERB_APP_KEY=develop-reverb-key
REVERB_APP_SECRET=develop-reverb-secret
REVERB_HOST=ingv.test
REVERB_PORT=8089
REVERB_SCHEME=http

PYGEOAPI_BASE_URL=http://pygeoapi
PYGEOAPI_SERVER_URL=http://localhost:5000

PHP_MEMORY_LIMIT=2G
PHP_MAX_EXECUTION_TIME=120
PHP_MAX_INPUT_TIME=60
PHP_MAX_INPUT_VARS=3000
PHP_UPLOAD_MAX_FILE_SIZE=100M
PHP_POST_MAX_SIZE=100M
NGINX_CLIENT_MAX_BODY_SIZE=100M
PHP_OPCACHE_ENABLE=0
PHP_OPCACHE_MEMORY_CONSUMPTION=256
PHP_OPCACHE_MAX_ACCELERATED_FILES=20000
PHP_OPCACHE_REVALIDATE_FREQ=0
PHP_OPCACHE_VALIDATE_TIMESTAMPS=1
SSL_MODE=off

VITE_APP_NAME="Pygeoapi Proxy"
